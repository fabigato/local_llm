# Copy to .env and fill in:  cp .env.example .env && chmod 600 .env
# Read by docker compose for this directory only (not the repo-root .env).

# --- Image / host ---
HERMES_IMAGE_TAG=v0.22.5
# Host port for the dashboard, bound to 127.0.0.1 only. Keep it off 9119
# (the host's own `hermes dashboard` default).
HERMES_DASHBOARD_HOST_PORT=9120

# --- LLM (Venice AI) ---
# Same key as the tezcatlipoca profile (HERMES_CUSTOM_API_VENICE_AI_API_KEY in
# ~/.hermes/profiles/tezcatlipoca/.env). Better: mint a separate key in Venice
# for your friend, so you can cap or revoke it without touching yours.
VENICE_API_KEY=

# --- Telegram ---
# Bot token from @BotFather (create a NEW bot; never reuse the host Hermes or
# openclaw bot — two pollers on one token steal each other's updates).
TELEGRAM_BOT_TOKEN=
# Your friend's numeric Telegram user ID (ask them to message @userinfobot).
# Comma-separated for several people. Anyone not listed is ignored.
TELEGRAM_ALLOWED_USERS=

# --- Dashboard login (http://127.0.0.1:9120) ---
HERMES_DASHBOARD_USERNAME=admin
# openssl rand -base64 24
HERMES_DASHBOARD_PASSWORD=
# openssl rand -base64 32
HERMES_DASHBOARD_SECRET=

# --- Web search and fetch (same backends as tezcatlipoca) ---
# Brave Search API (search) and Tavily (page extraction). Copied from the
# tezcatlipoca profile's .env; separate free-tier keys keep her usage off your quota.
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# --- Optional ---
# Only if you enable the API server in docker-compose.yml. openssl rand -hex 32
# HERMES_API_SERVER_KEY=
