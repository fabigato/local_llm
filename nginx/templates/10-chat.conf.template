# Open WebUI — https://chat.${DOMAIN}
#
# TLS is inherited from the http-level ssl_certificate in nginx.conf (one wildcard
# cert for *.${DOMAIN}), so nothing certificate-related appears here. That is the
# whole payoff of the wildcard: a new service is a new file like this one, plus a
# DNS record. No issuance, no renewal config, no restart of anything else.

server {
    listen 443 ssl;
    http2 on;

    server_name chat.${DOMAIN};

    # Open WebUI uploads (documents for RAG, images) can be large.
    client_max_body_size 100M;

    location / {
        # NOT a redirect: this is nginx's own outbound connection to the
        # open-webui container over the compose network. Port 8080 is never
        # published to the host and `open-webui` only resolves inside that
        # network — no client outside ever sees or reaches this URL.
        proxy_pass http://open-webui:8080;

        proxy_http_version 1.1;

        proxy_set_header Host $host;

        # Open WebUI uses websockets for streaming chat responses.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Long generations must not be cut off by a proxy timeout.
        proxy_read_timeout 3600;
    }
}
