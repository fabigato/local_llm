# LLM API (LM Studio) — safe internet exposure (same recipe as 00-whisper.conf.template).
#
# The file and the names below ($ollama_user, log format `ollama`, zone `ollama`)
# date from when this fronted Ollama. Since 2026-10-12 the upstream is LM Studio
# on 127.0.0.1:1234 (see 12-llm.conf.template); the names stayed so the
# OLLAMA_AUTH_TOKEN* values in .env and the tokens already handed out keep working.
#
# NOTE ON THE "01-" FILENAME PREFIX: like 00-whisper, this loads before
# 12-llm.conf (alphabetical `include conf.d/*.conf`) so `log_format ollama`
# below is parsed before the `access_log ... ollama` that uses it.
# (map_hash_bucket_size, which the long "Bearer <token>" keys need, is set
# http-globally in nginx.conf.)
#
# Like 00-whisper, this file holds only the http-context directives; the matching
# `location /` is in 12-llm.conf.template.
#
# Reached publicly at: https://llm.${DOMAIN}/v1/chat/completions

# Bearer-token gate, one line per authorized person (see the whisper file for the
# full rationale). Value is the person's name; "" = unauthorized. Separate from
# whisper's map so the two services have independent access lists and logs.
map $http_authorization $ollama_user {
    default                                 "";        # unauthorized

    "Bearer ${OLLAMA_AUTH_TOKEN}"           "owner";

    # Add more people like this (uncomment, add matching env var + .env value):
    "Bearer ${OLLAMA_AUTH_TOKEN2}"          "simi";
    #"Bearer ${OLLAMA_AUTH_TOKEN_BOB}"       "bob";
}

# Per-request access log recording which person's token was used.
log_format ollama '$remote_addr user=$ollama_user [$time_local] '
                  '"$request" $status ${body_bytes_sent}b';

# Rate limit. Inference is heavy, but a chat client fires several requests in a
# row, so this is looser than whisper's. Tune to taste.
#
# Same caveat as whisper's zone: this is effectively GLOBAL, not per-IP, because
# Docker's proxy makes $remote_addr always the gateway. See the long note in
# 00-whisper.conf.template.
limit_req_zone $binary_remote_addr zone=ollama:10m rate=30r/m;
