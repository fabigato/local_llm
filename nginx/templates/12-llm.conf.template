# LLM API (LM Studio) — https://llm.${DOMAIN}
#
# OpenAI-compatible, at the ROOT of its own subdomain:
#     https://llm.${DOMAIN}/v1/chat/completions   (model: qwen3.8-27b)
#     https://llm.${DOMAIN}/v1/models
# This used to proxy Ollama (2026-10-12 switch). Ollama's native /api/chat and
# /api/generate are gone; clients must use the /v1 OpenAI API.
#
# The $ollama_user map, `ollama` log format and `ollama` rate-limit zone keep
# their Ollama-era names on purpose, so the OLLAMA_AUTH_TOKEN* values in .env
# and every token already handed out keep working.
#
# The http-context directives this block depends on — the $ollama_user bearer
# map, the `ollama` log format, and the `ollama` rate-limit zone — live in
# 01-ollama.conf.template, which loads first (alphabetical include).
#
# LM Studio (llmster, launchd job com.local.llmster) runs on the HOST bound to
# 127.0.0.1:1234 (loopback only). Keep it that way: containers reach it over
# host.docker.internal and Docker Desktop forwards to the host loopback, so nginx
# stays the ONLY public door. Do NOT bind it to 0.0.0.0 to make this work.

server {
    listen 443 ssl;
    http2 on;

    server_name llm.${DOMAIN};

    # Multimodal requests carry base64-encoded images.
    client_max_body_size 100M;

    location / {
        # CORS preflight (see the whisper template for why): answer the browser's
        # unauthenticated OPTIONS before the auth check.
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin  "*" always;
            add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Authorization, Content-Type" always;
            add_header Access-Control-Max-Age       86400 always;
            return 204;
        }
        # The upstream sets its OWN CORS headers. Strip them so ours isn't
        # duplicated — browsers reject a response with two
        # Access-Control-Allow-Origin values — then set exactly one below.
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
        proxy_hide_header Access-Control-Allow-Methods;
        proxy_hide_header Access-Control-Allow-Headers;
        # Let the browser read the actual (non-preflight) response.
        add_header Access-Control-Allow-Origin "*" always;

        # Require a valid bearer token; $ollama_user is the caller's name.
        if ($ollama_user = "") {
            return 401;
        }
        # Inference/read only, as an ALLOWLIST: everything outside /v1/ is
        # refused even for valid tokens. LM Studio's native /api/v0 and /api/v1
        # trees include model download, load and unload, and a leaked token must
        # not be able to fill the disk or evict the loaded model. /v1/ holds only
        # the OpenAI- and Anthropic-compatible inference endpoints.
        if ($uri !~ "^/v1/") {
            return 403;
        }

        limit_req zone=ollama burst=20 nodelay;
        access_log /var/log/nginx/ollama.log ollama;

        # No path rewriting: /v1/... passes through untouched. Don't add a
        # trailing slash here.
        proxy_pass http://host.docker.internal:1234;

        proxy_http_version 1.1;
        # Present a local Host rather than the public domain: the server only
        # ever expects to be addressed as itself on loopback.
        proxy_set_header Host "127.0.0.1:1234";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Streams tokens; disable buffering so they flush to the client,
        # and allow long generations without nginx timing out.
        proxy_buffering off;
        proxy_read_timeout 3600;
    }
}
