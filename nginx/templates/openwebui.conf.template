server {
    listen 80;

    server_name ${PRIMARY_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 80;

    server_name ${SECONDARY_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;

    server_name ${PRIMARY_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${PRIMARY_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PRIMARY_DOMAIN}/privkey.pem;

    client_max_body_size 100M;

    # Whisper transcription API (host service on :${WHISPER_SERVER_PORT}).
    # Auth map + rate-limit zone are defined in 00-whisper.conf.template.
    location /whisper/ {
        # CORS preflight: browser/Electron clients (e.g. the Obsidian plugin) send
        # an unauthenticated OPTIONS before the real POST. Answer it here, BEFORE
        # the auth check — otherwise it 401s and the client reports "network error".
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin  "*" always;
            add_header Access-Control-Allow-Methods "POST, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Authorization, Content-Type" always;
            add_header Access-Control-Max-Age       86400 always;
            return 204;
        }
        # The upstream (whisper/ollama) sets its OWN CORS headers. Strip them so
        # ours isn't duplicated — browsers reject a response with two
        # Access-Control-Allow-Origin values — then set exactly one below.
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
        proxy_hide_header Access-Control-Allow-Methods;
        proxy_hide_header Access-Control-Allow-Headers;
        # Let the browser read the actual (non-preflight) response.
        add_header Access-Control-Allow-Origin "*" always;

        # Require a valid bearer token; reject everything else before proxying.
        # $whisper_user is the caller's name (empty = unknown token). Map + log
        # format live in 00-whisper.conf.template.
        if ($whisper_user = "") {
            return 401;
        }
        access_log /var/log/nginx/whisper.log whisper;
        # Only POST reaches whisper — the transcription endpoint is POST-only.
        if ($request_method !~ ^(POST)$) {
            return 405;
        }

        limit_req zone=whisper burst=5 nodelay;

        # Bound uploads (OpenAI's own cap is 25MB; adjust to taste).
        client_max_body_size 50M;

        # Strip the /whisper/ prefix so whisper sees /v1/audio/transcriptions.
        proxy_pass http://host.docker.internal:${WHISPER_SERVER_PORT}/;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Transcription can be slow; give it room but don't hang forever.
        proxy_read_timeout 300;
    }

    # Ollama API (host service on 127.0.0.1:11434, loopback-only — nginx is the
    # only public door). Auth map, rate-limit zone and log format: 01-ollama.conf.template.
    location /ollama/ {
        # CORS preflight (see the whisper location for why): answer the browser's
        # unauthenticated OPTIONS before the auth check.
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin  "*" always;
            add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Authorization, Content-Type" always;
            add_header Access-Control-Max-Age       86400 always;
            return 204;
        }
        # The upstream (whisper/ollama) sets its OWN CORS headers. Strip them so
        # ours isn't duplicated — browsers reject a response with two
        # Access-Control-Allow-Origin values — then set exactly one below.
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
        proxy_hide_header Access-Control-Allow-Methods;
        proxy_hide_header Access-Control-Allow-Headers;
        # Let the browser read the actual (non-preflight) response.
        add_header Access-Control-Allow-Origin "*" always;

        # Require a valid bearer token; $ollama_user is the caller's name.
        if ($ollama_user = "") {
            return 401;
        }
        # Block model-management endpoints even for valid tokens: a leaked token
        # must not be able to delete or bloat your models. Inference/read only.
        if ($uri ~* "^/ollama/api/(pull|push|delete|create|copy|blobs)") {
            return 403;
        }

        limit_req zone=ollama burst=20 nodelay;
        access_log /var/log/nginx/ollama.log ollama;

        # Multimodal requests carry base64 images, so allow a generous body.
        client_max_body_size 100M;

        # Strip the /ollama/ prefix so ollama sees /api/... and /v1/... unchanged.
        proxy_pass http://host.docker.internal:11434/;

        proxy_http_version 1.1;
        # Ollama validates the Host header (DNS-rebinding guard) and rejects any
        # non-local value with 403. Present a local Host rather than the public
        # domain, so it trusts the proxied request.
        proxy_set_header Host "127.0.0.1:11434";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Ollama streams tokens; disable buffering so they flush to the client,
        # and allow long generations without nginx timing out.
        proxy_buffering off;
        proxy_read_timeout 3600;
    }

    location / {
        proxy_pass http://open-webui:8080;

        proxy_http_version 1.1;

        proxy_set_header Host $host;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 3600;
    }
}

