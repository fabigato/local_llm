<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

  <key>Label</key>
  <string>com.certbot.docker.renew</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string><path-to-script>/certbot-renew.sh</string>
  </array>

  <key>StartInterval</key>
  <integer>43200</integer> <!-- 12 hours -->

  <key>RunAtLoad</key>
  <true/>

  <!-- important for Docker access -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
  </dict>

  <!-- Capture output. DNS-01 renewal has failure modes that produce no visible
       symptom for up to 90 days (a revoked API token, an Infomaniak API change),
       unlike the old webroot flow where a broken nginx was immediately obvious.
       These logs are the only place that surfaces. Check them if a cert nears
       expiry:  tail -n 50 /tmp/certbot-renew.err
       Deeper detail lands in nginx/certbot/logs/letsencrypt.log. -->
  <key>StandardOutPath</key>
  <string>/tmp/certbot-renew.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/certbot-renew.err</string>

</dict>
</plist>
